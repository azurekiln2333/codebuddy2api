# Copy to .env and fill in real values before starting. Never commit .env.
# The gateway fails closed at startup when required secrets or HTTPS origins
# are missing (explicit loopback development escape: ALLOW_INSECURE_LOCALHOST=true).

# Public origin of the gateway as browsers see it (must be HTTPS in production,
# no trailing slash). This is the OIDC redirect_uri base and Origin allowlist.
PUBLIC_ORIGIN=https://gateway.example.com

# Listener. Keep it bound to loopback when Nginx runs on the same host, or to
# the private compose network (HOST=0.0.0.0) when Nginx is a sibling container.
HOST=127.0.0.1
PORT=8788

# Private upstream FastAPI admin/inference listener. Never expose this port.
# `http://` or `https://` are both accepted; the gateway selects the matching
# transport. `127.0.0.1:8787` is the native/loopback default; in compose use the
# stable service alias `http://codebuddy2api:8787`.
UPSTREAM_ORIGIN=http://127.0.0.1:8787
# Backend api_key used by the gateway bridge to open a per-session admin
# session. This is the same value configured as CODEBUDDY2API_KEY upstream.
UPSTREAM_API_KEY=

# OIDC confidential client. Issuer must expose discovery/JWKS over HTTPS.
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set true to request offline_access and use rotating refresh tokens.
OIDC_REFRESH=false

# External UI build directory (mounted read-only in containers).
UI_STATIC_DIR=/opt/codebuddy2api-ui/dist

# Session TTL default is 8h (28_800_000 ms); idle default 30m (1_800_000 ms).
SESSION_TTL_MS=28800000
SESSION_IDLE_MS=1800000
TRANSACTION_TTL_MS=300000
MAX_SESSIONS=1000
OAUTH_TIMEOUT_MS=5000
UPSTREAM_TIMEOUT_MS=30000
STREAM_TIMEOUT_MS=300000
MAX_BODY_BYTES=16777216

# Development-only escape hatch: allow HTTP loopback origins and non-Secure
# cookies. NEVER enable in production.
ALLOW_INSECURE_LOCALHOST=false
